{
  "name": "antiflock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AntiFlock — a 3D combat robotics simulator with real physics, real damage, and a real arena.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
